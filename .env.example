# URL publique du portfolio (SEO / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://alexis-romney.com/

# --- Contact (Resend) — serveur uniquement, JAMAIS NEXT_PUBLIC_ ---
# Copier vers `.env.local` puis renseigner. Ne jamais committer `.env.local`.

# Clé API Resend (dashboard → API Keys). Doit commencer par re_
RESEND_API_KEY=

# Expéditeur (domaine vérifié dans Resend).
# Dev sans domaine : onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Nom affiché de l'expéditeur
CONTACT_FROM_NAME=Portfolio Alexis Romney

# Note : le destinataire (to) est fixé côté serveur à Alexis.romney@hotmail.fr
# L'e-mail du visiteur sert uniquement de Reply-To + contenu du message.
