# URL publique du portfolio (SEO / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://alexis-romney.com/

# =============================================================================
# 1) Formulaire « Me contacter » (Resend Contact)
#    Serveur uniquement — JAMAIS NEXT_PUBLIC_
# =============================================================================
# Clé Resend dédiée au contact portfolio uniquement.
# Distincte de RESEND_AUTOMATION_API_KEY.
RESEND_API_KEY=

# Expéditeur (domaine vérifié dans Resend).
# Dev sans domaine : onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Nom affiché de l'expéditeur
CONTACT_FROM_NAME=Portfolio Alexis Romney

# Note : le destinataire (to) est fixé côté serveur à Alexis.romney@hotmail.fr
# L'e-mail du visiteur sert uniquement de Reply-To + contenu du message.


# =============================================================================
# 2) Démo Gestion des demandes (Resend Automation + reste)
#    Serveur uniquement — JAMAIS NEXT_PUBLIC_
# =============================================================================
# GD_DEMO_ISOLATED=true : mode démo sécurisé (défaut si absent)
#   - Écritures BDD autorisées pour tickets démo + workflow (IA, Trigger, logs)
#   - Interdit : collab CRUD, settings PATCH, mutation/suppression tickets hors démo
#   - Emails Resend réels, max 5 envois / adresse destinataire (côté serveur)
# Mettre à false uniquement pour un debug sans garde-fous.
GD_DEMO_ISOLATED=true

# DATABASE_URL=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Trigger.dev
# Local  : clé DEV (tr_dev_…) + `npm run trigger:dev`
# Prod   : clé PROD (tr_prod_…) sur Vercel + tâches déployées (`npm run trigger:deploy`)
# Ne jamais exposer côté client / Git.
# -----------------------------------------------------------------------------
# TRIGGER_SECRET_KEY=

# Clé Resend dédiée à l'automatisation (Trigger.dev / emails workflow).
# Distincte de RESEND_API_KEY (formulaire Contact). Ne jamais exposer côté client.
RESEND_AUTOMATION_API_KEY=

# Expéditeur Resend pour les emails d'automatisation (domaine vérifié).
AUTOMATION_FROM_EMAIL=

# URL publique de la démo (liens dans les emails d'automatisation).
# Local : http://localhost:3000/gestion-demandes
# Prod  : https://votre-domaine/gestion-demandes
# APP_URL=http://localhost:3000/gestion-demandes
